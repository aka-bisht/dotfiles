// Zed settings

{
  "centered_layout": {
    "left_padding": 0.18,
    "right_padding": 0.18,
  },
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "nvidia/nemotron-3.5-lightning:free",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_font_size": 17,
  "show_edit_predictions": false,
  "icon_theme": "Zed (Default)",
  "agent_buffer_font_size": 15,
  "buffer_font_family": "FiraMono Nerd Font",
  "ui_font_size": 17,
  "buffer_font_weight": 300,
  "relative_line_numbers": "enabled",
  "agent_ui_font_size": 17,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Mellow",
  },
  "scrollbar": {
    "show": "never",
  },
  "soft_wrap": "editor_width",
  "gutter": {
    "folds": false,
  },
  "experimental.theme_overrides": {
    "title_bar.background": "#161617",
    "toolbar.background": "#161617",
    "tab.active_background": "#161617",
    "tab_bar.background": "#27272a",
    "border": "#131314",
    "elevated_surface.background": "#27272a",
    "terminal.background": "#161617",
    "tab.inactive_background": "#27272a",
    "border.variant": "#131314",
    "status_bar.background": "#161617",
    "syntax": {
      "comment": {
        "font_style": "normal",
      },
    },
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
    "default_width": 350,
  },
  "collaboration_panel": {
    "dock": "left",
    "default_width": 350,
  },
  "git_panel": {
    "dock": "left",
    "default_width": 350,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "default_width": 350
  },
  "vim_mode": true,
  "hide_mouse": "on_typing_and_action",
  "terminal": {
    "font_family": "JetBrainsMonoNL Nerd Font",
    "font_weight": 300,
    "line_height": {
      "custom": 1.4,
    },
    "default_height": 420,
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 1000,
  },
  "inline_code_actions": false,
  "code_lens": "on",
}

